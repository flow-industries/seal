{
  "name": "@flow-industries/seal",
  "version": "0.1.0",
  "description": "End-to-end encrypted vault core: the container, signed access, journal sync and the device client",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flow-industries/seal.git"
  },
  "homepage": "https://github.com/flow-industries/seal#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build",
    "lint": "biome check",
    "format": "biome format --write",
    "check": "biome check --write",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:node": "bun build tests/device-node.ts --target=node --outfile .tmp/device-node.mjs && node .tmp/device-node.mjs",
    "test:package": "bun run build && node tests/package.mjs",
    "size": "bun run scripts/device-bundle.ts"
  },
  "dependencies": {
    "@flow-industries/id": "0.34.0",
    "@lezer/markdown": "1.8.0",
    "dexie": "^4.4.6",
    "fflate": "^0.8.3",
    "libsodium-wrappers-sumo": "0.8.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@flow-industries/lint": "0.3.1",
    "@ipld/car": "^5.4.7",
    "@ipld/dag-cbor": "^10.0.2",
    "@types/bun": "^1.3.14",
    "@types/libsodium-wrappers-sumo": "^0.8.2",
    "@types/node": "^24.10.4",
    "biome-anti-slop": "0.1.0",
    "fake-indexeddb": "^6.2.4",
    "typescript": "~5.9.3"
  }
}
